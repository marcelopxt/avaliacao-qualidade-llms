class Solution {

    /**
     * @param Integer[] $nums
     * @return Integer
     */
    function centeredSubarrays($nums) {
        $n = count($nums);
        $count = 0;

        for ($i = 0; $i < $n; $i++) {
            $sum = 0;
            $seen = [];
            for ($j = $i; $j < $n; $j++) {
                $val = $nums[$j];
                $sum += $val;
                $seen[$val] = true;
                
                if (isset($seen[$sum])) {
                    $count++;
                }
            }
        }

        return $count;
    }
}