class Solution {

    /**
     * @param Integer[] $rowSum
     * @param Integer[] $colSum
     * @return Integer[][]
     */
    function restoreMatrix($rowSum, $colSum) {
        $numRows = count($rowSum);
        $numCols = count($colSum);
        $matrix = array_fill(0, $numRows, array_fill(0, $numCols, 0));
        
        $i = 0;
        $j = 0;
        
        while ($i < $numRows && $j < $numCols) {
            $value = min($rowSum[$i], $colSum[$j]);
            $matrix[$i][$j] = $value;
            
            $rowSum[$i] -= $value;
            $colSum[$j] -= $value;
            
            if ($rowSum[$i] == 0) {
                $i++;
            }
            if ($colSum[$j] == 0) {
                $j++;
            }
        }
        
        return $matrix;
    }
}