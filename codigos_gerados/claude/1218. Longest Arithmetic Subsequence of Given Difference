class Solution {

    /**
     * @param Integer[] $arr
     * @param Integer $difference
     * @return Integer
     */
    function longestSubsequence($arr, $difference) {
        $dp = [];
        $max = 1;
        foreach ($arr as $num) {
            $prev = $num - $difference;
            $len = isset($dp[$prev]) ? $dp[$prev] + 1 : 1;
            $dp[$num] = $len;
            if ($len > $max) {
                $max = $len;
            }
        }
        return $max;
    }
}