class Solution {

    /**
     * @param String $s
     * @param Integer $encCost
     * @param Integer $flatCost
     * @return Integer
     */
    function minCost($s, $encCost, $flatCost) {
        $n = strlen($s);
        $prefix = array_fill(0, $n + 1, 0);
        for ($i = 0; $i < $n; $i++) {
            $prefix[$i + 1] = $prefix[$i] + ($s[$i] === '1' ? 1 : 0);
        }

        $solve = function ($start, $len) use (&$solve, &$prefix, $encCost, $flatCost) {
            $x = $prefix[$start + $len] - $prefix[$start];
            if ($x == 0) {
                $cost = $flatCost;
            } else {
                $cost = $len * $x * $encCost;
            }

            if ($len % 2 == 0) {
                $half = intdiv($len, 2);
                $splitCost = $solve($start, $half) + $solve($start + $half, $half);
                if ($splitCost < $cost) {
                    $cost = $splitCost;
                }
            }

            return $cost;
        };

        return $solve(0, $n);
    }
}