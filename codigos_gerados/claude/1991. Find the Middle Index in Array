class Solution {

    /**
     * @param Integer[] $nums
     * @return Integer
     */
    function findMiddleIndex($nums) {
        $total = array_sum($nums);
        $leftSum = 0;
        foreach ($nums as $i => $num) {
            $rightSum = $total - $leftSum - $num;
            if ($leftSum == $rightSum) {
                return $i;
            }
            $leftSum += $num;
        }
        return -1;
    }
}