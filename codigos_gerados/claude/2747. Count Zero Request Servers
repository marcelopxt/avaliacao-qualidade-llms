class Solution {

    /**
     * @param Integer $n
     * @param Integer[][] $logs
     * @param Integer $x
     * @param Integer[] $queries
     * @return Integer[]
     */
    function countServers($n, $logs, $x, $queries) {
        usort($logs, function($a, $b) {
            return $a[1] <=> $b[1];
        });

        $q = count($queries);
        $idx = range(0, $q - 1);
        usort($idx, function($a, $b) use ($queries) {
            return $queries[$a] <=> $queries[$b];
        });

        $result = array_fill(0, $q, 0);
        $count = array_fill(0, $n + 1, 0);
        $active = 0;

        $left = 0;
        $right = 0;
        $m = count($logs);

        foreach ($idx as $i) {
            $query = $queries[$i];
            $start = $query - $x;
            $end = $query;

            while ($right < $m && $logs[$right][1] <= $end) {
                $sid = $logs[$right][0];
                if ($count[$sid] == 0) {
                    $active++;
                }
                $count[$sid]++;
                $right++;
            }

            while ($left < $right && $logs[$left][1] < $start) {
                $sid = $logs[$left][0];
                $count[$sid]--;
                if ($count[$sid] == 0) {
                    $active--;
                }
                $left++;
            }

            $result[$i] = $n - $active;
        }

        return $result;
    }
}