<?php
class Solution {

    /**
     * @param String $s
     * @return Integer
     */
    function minAddToMakeValid($s) {
        $balance = 0;
        $moves = 0;
        $n = strlen($s);
        for ($i = 0; $i < $n; $i++) {
            if ($s[$i] === '(') {
                $balance++;
            } else {
                if ($balance > 0) {
                    $balance--;
                } else {
                    $moves++;
                }
            }
        }
        return $moves + $balance;
    }
}
